pipeline {
    agent any
    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        DOCKER_IMAGE = 'hanna10/tetrisv1'  
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/hannaodu/End-to-End-Kubernetes-DevSecOps-Tetris.git'
            }
        }
        stage('Sonarqube Analysis') {
            steps {
                dir('Tetris-V1') {
                    withSonarQubeEnv('sonar-server') {
                        sh """ 
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=TetrisVersion1.0 \
                            -Dsonar.projectKey=TetrisVersion1.0 
                        """
                    }
                }
            }
        }
        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage('Installing Dependencies') {
            steps {
                dir('Tetris-V1') {
                    sh 'npm install'
                }
            }
        }
        stage('OWASP Dependency-Check Scan') {
            steps {
                dir('Tetris-V1') {
                    dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP-Check'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }
        
        // === REPLACED: Trivy File Scan ===
        stage('Trivy File Scan') {
            steps {
                dir('Tetris-V1') {
                    script {
                        sh '''
                            # Simple one-liner Trivy installation and scan
                            curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /tmp && /tmp/trivy fs . --exit-code 0 > trivyfs.txt
                            echo "Trivy scan completed"
                        '''
                    }
                }
            }
        }
        
        // === REPLACED: Docker Image Build ===
        stage("Docker Image Build") {
            steps {
                script {
                    dir('Tetris-V1') {
                        sh 'docker build -t tetrisv1 .'
                    }
                }
            }
        }
        
        // === REPLACED: Docker Image Pushing ===
        stage("Docker Image Pushing") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh """
                            docker tag tetrisv1 ${DOCKER_IMAGE}:${BUILD_NUMBER}
                            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                        """
                    }
                }
            }
        }
        
        // === REPLACED: TRIVY Image Scan ===
        stage("TRIVY Image Scan") {
            steps {
                script {
                    sh """
                        /tmp/trivy image ${DOCKER_IMAGE}:${BUILD_NUMBER} --exit-code 0 > trivyimage.txt
                        echo "Trivy image scan completed"
                    """
                }
            }
        }
        
        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "End-to-End-Kubernetes-DevSecOps-Tetris"
                GIT_USER_NAME = "hannaodu"
            }
            steps {
                dir('Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                        sh """
                            git config user.email "tennyalana@yahoo.com"
                            git config user.name "hannaodu"
                            echo "Build Number: ${BUILD_NUMBER}"
                            # Extract current image tag and replace with new build number
                            sed -i "s|tetrisv1:[^\\\"']*|tetrisv1:${BUILD_NUMBER}|g" deployment-service.yml
                            git add deployment-service.yml
                            git commit -m "Update deployment Image to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                        """
                    }
                }
            }
        }
    }
}
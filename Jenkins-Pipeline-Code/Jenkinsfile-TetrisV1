pipeline {
    agent any
    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/hannaodu/End-to-End-Kubernetes-DevSecOps-Tetris.git'
            }
        }
        stage('Sonarqube Analysis') {
            steps {
                dir('Tetris-V1') {
                    withSonarQubeEnv('sonar-server') {
                        sh """ 
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=TetrisVersion1.0 \
                            -Dsonar.projectKey=TetrisVersion1.0 
                        """
                    }
                }
            }
        }
        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonor-token'
                }
            }
        }
        stage('Installing Dependencies') {
            steps {
                dir('Tetris-V1') {
                    sh 'npm install'
                }
            }
        }
        stage('OWASP Dependency-Check Scan') {
            steps {
                dependencyCheck additionalArguments: '--scan . --format HTML --format JSON', 
                             odcInstallation: 'DP-Check'
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }
        
        // === SIMPLE TRIVY DOWNLOAD ===
        stage('Security Scan') {
            steps {
                dir('Tetris-V1') {
                    sh '''
                        # Download and extract Trivy
                        wget -q -O /tmp/trivy.tar.gz https://github.com/aquasecurity/trivy/releases/download/v0.49.1/trivy_0.49.1_Linux-64bit.tar.gz
                        tar -xzf /tmp/trivy.tar.gz -C /tmp trivy
                        # Run scan
                        /tmp/trivy fs . --exit-code 0 --format table > trivyfs.txt
                        echo "Security scan completed"
                    '''
                }
            }
        }
        
        stage("Docker Build") {
            steps {
                dir('Tetris-V1') {
                    sh 'docker build -t tetrisv1 .'
                }
            }
        }
        
        stage("Docker Push") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh """
                            docker tag tetrisv1 hanna10/tetrisv1:${BUILD_NUMBER}
                            docker push hanna10/tetrisv1:${BUILD_NUMBER}
                        """
                    }
                }
            }
        }
        
        stage("Image Security Scan") {
            steps {
                sh """
                    /tmp/trivy image hanna10/tetrisv1:${BUILD_NUMBER} --exit-code 0 --format table > trivyimage.txt
                    echo "Image security scan completed"
                """
            }
        }
        
        stage('Update Deployment') {
            environment {
                GIT_REPO_NAME = "End-to-End-Kubernetes-DevSecOps-Tetris"
                GIT_USER_NAME = "hannaodu"
            }
            steps {
                dir('Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                        sh """
                            git config user.email "tennyalana@yahoo.com"
                            git config user.name "hannaodu"
                            sed -i "s|tetrisv1:[^\\\"']*|tetrisv1:${BUILD_NUMBER}|g" deployment-service.yml
                            git add deployment-service.yml
                            git commit -m "Update deployment Image to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                        """
                    }
                }
            }
        }
    }
}